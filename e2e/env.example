# คัดลอกไฟล์นี้เป็น e2e/.env.e2e แล้วใส่บัญชีสำหรับทดสอบ (ไฟล์ .env.e2e ไม่ถูก commit)

# URL ของระบบที่จะทดสอบ
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:5050

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# (ไม่บังคับ) บัญชีผู้เรียน (role_id = 1) สำหรับเคสทดสอบสิทธิ์การเข้าถึง
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
